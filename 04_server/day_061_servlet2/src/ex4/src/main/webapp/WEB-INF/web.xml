<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- Filter 정의 -->
    <filter>
        <filter-name>DecoFilter</filter-name>
        <filter-class>org.scoula.ex4.DecoFilter</filter-class>
    </filter>
    <filter>
        <filter-name>PerformanceMonitorFilter</filter-name>
        <filter-class>org.scoula.ex4.PerformanceMonitorFilter</filter-class>
    </filter>

    <!-- Filter 매핑 순서: DecoFilter -> PerformanceMonitorFilter -> Servlet -->
    <filter-mapping>
        <filter-name>DecoFilter</filter-name>
        <url-pattern>/deco/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>PerformanceMonitorFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

</web-app>
